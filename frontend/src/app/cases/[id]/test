function TopologyTab({
  caseId,
  evidenceId,
  analysis,
}: {
  caseId: string;
  evidenceId: string;
  analysis: PcapAnalysis | null;
}) {
  const [topology, setTopology] =
    useState<NetworkTopology | null>(
      null
    );

  const [loading, setLoading] =
    useState(true);

  const [error, setError] =
    useState<string | null>(null);

  const [search, setSearch] =
    useState("");

  const [selectedNode, setSelectedNode] =
    useState<string | null>(null);


  async function loadTopology() {
    try {
      setLoading(true);
      setError(null);

      const data =
        await getNetworkTopology(
          caseId,
          evidenceId
        );

      setTopology(data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to load topology"
      );
    } finally {
      setLoading(false);
    }
  }


  useEffect(() => {
    void loadTopology();
  }, [
    caseId,
    evidenceId,
  ]);


  if (!analysis) {
    return (
      <EmptyState
        title="Analyze the PCAP first"
        description="The network topology is generated from analyzed network flows."
      />
    );
  }


  if (loading) {
    return (
      <div className="rounded-2xl border border-zinc-200 bg-white p-12 text-center text-sm text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900">
        Loading network topology...
      </div>
    );
  }


  if (error) {
    return (
      <div className="rounded-2xl border border-red-200 bg-red-50 p-8 text-center dark:border-red-900 dark:bg-red-950/20">

        <p className="text-sm font-medium text-red-700 dark:text-red-400">
          Unable to load topology
        </p>

        <p className="mt-2 text-xs text-red-600 dark:text-red-400">
          {error}
        </p>

        <button
          type="button"
          onClick={() =>
            void loadTopology()
          }
          className="mt-5 inline-flex items-center gap-2 rounded-lg bg-zinc-950 px-3 py-2 text-xs font-medium text-white dark:bg-white dark:text-zinc-950"
        >
          <Icon
            name="refresh"
            size={14}
          />

          Retry
        </button>

      </div>
    );
  }


  if (!topology) {
    return (
      <EmptyState
        title="No topology available"
        description="No communication topology was generated for this evidence."
      />
    );
  }


  /*
   * SEARCH
   */

  const query =
    search
      .trim()
      .toLowerCase();


  const matchingNodeIds =
    new Set(
      topology.nodes
        .filter((node) => {
          if (!query) {
            return true;
          }

          return (
            node.id
              .toLowerCase()
