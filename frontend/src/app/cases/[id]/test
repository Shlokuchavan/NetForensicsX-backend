/* =========================================================
   HELPERS
========================================================= */

function formatNumber(
  value: number
): string {
  return new Intl.NumberFormat(
    "en-US"
  ).format(value);
}


function formatBytes(
  bytes: number
): string {
  if (
    !Number.isFinite(bytes) ||
    bytes <= 0
  ) {
    return "0 B";
  }

  const units = [
    "B",
    "KB",
    "MB",
    "GB",
    "TB",
  ];

  const index = Math.min(
    Math.floor(
      Math.log(bytes) /
        Math.log(1024)
    ),
    units.length - 1
  );

  return `${(
    bytes /
    Math.pow(1024, index)
  ).toFixed(
    index === 0 ? 0 : 2
  )} ${units[index]}`;
}


function formatTimestamp(
  timestamp: number | null
): string {
  if (timestamp === null) {
    return "—";
  }

  return new Date(
    timestamp * 1000
  ).toLocaleString();
}


function formatDuration(
  seconds: number
): string {
  if (!Number.isFinite(seconds)) {
    return "—";
  }

  const hours = Math.floor(
    seconds / 3600
  );

  const minutes = Math.floor(
    (seconds % 3600) / 60
  );

  const remainingSeconds =
    Math.floor(seconds % 60);

  if (hours > 0) {
    return `${hours}h ${minutes}m ${remainingSeconds}s`;
  }

  if (minutes > 0) {
    return `${minutes}m ${remainingSeconds}s`;
  }

  return `${remainingSeconds}s`;
}


function isPrivateIP(
  ip: string
): boolean {
  const value = ip.trim();

  if (
    value === "localhost" ||
    value === "127.0.0.1" ||
    value === "::1"
  ) {
    return true;
  }

  if (
    value.startsWith("10.") ||
    value.startsWith("192.168.")
  ) {
    return true;
  }

  if (value.startsWith("172.")) {
    const secondOctet =
      Number(
        value
          .split(".")[1]
      );

    if (
      secondOctet >= 16 &&
      secondOctet <= 31
    ) {
      return true;
    }
  }

  if (
    value.startsWith("169.254.")
  ) {
    return true;
  }

  if (value.startsWith("fc") ||
      value.startsWith("fd")) {
    return true;
  }

  return false;
}


function isDNSNode(
  node: NetworkTopology["nodes"][number]
): boolean {
  const value = `${node.id} ${node.label}`.toLowerCase();

  return (
    value.includes("dns") ||
    value.includes(":53") ||
    value.includes("domain")
  );
}


function getNodeIP(
  node: NetworkTopology["nodes"][number]
): string {
  return node.id || node.label;
}


function classifyNode(
  node: NetworkTopology["nodes"][number]
): TopologyZone {
  const ip =
    getNodeIP(node);

  if (isDNSNode(node)) {
    return "infrastructure";
  }

  if (isPrivateIP(ip)) {
    return "internal";
  }

  return "external";
}


function getProtocolLabel(
  edge: NetworkTopology["edges"][number]
): string {
  const candidate = edge as NetworkTopology["edges"][number] & {
    protocol?: string;
    protocols?: string[];
    destination_port?: number;
    port?: number;
  };

  if (
    Array.isArray(
      candidate.protocols
    ) &&
    candidate.protocols.length > 0
  ) {
    return candidate.protocols
      .slice(0, 2)
      .join(" / ");
  }

  if (
    typeof candidate.protocol ===
    "string"
  ) {
    return candidate.protocol;
  }

  return "FLOW";
}


function getEdgePortLabel(
  edge: NetworkTopology["edges"][number]
): string {
  const candidate = edge as NetworkTopology["edges"][number] & {
    destination_port?: number;
    port?: number;
  };

  if (
    typeof candidate.destination_port ===
    "number"
  ) {
    return `:${candidate.destination_port}`;
  }

  if (
    typeof candidate.port ===
    "number"
  ) {
    return `:${candidate.port}`;
  }

  return "";
}


