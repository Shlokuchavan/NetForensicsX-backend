            <div className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

              <div>

                <p className="text-[10px] font-semibold uppercase tracking-[0.12em] text-zinc-400">
                  Selected Host
                </p>

                <p className="mt-1 font-mono text-sm font-semibold text-zinc-950 dark:text-white">
                  {selectedNodeData.label}
                </p>

                <p className="mt-1 text-xs text-zinc-500">
                  {classifyNode(
                    selectedNodeData
                  ) ===
                  "internal"
                    ? "Internal network system"
                    : classifyNode(
                          selectedNodeData
                        ) ===
                        "infrastructure"
                      ? "DNS / infrastructure system"
                      : "External network system"}
                </p>

              </div>


              <div className="grid grid-cols-2 gap-3 sm:grid-cols-4">

                <div className="rounded-xl border border-zinc-200 bg-white px-4 py-3 dark:border-zinc-800 dark:bg-zinc-900">

                  <p className="text-[9px] uppercase tracking-wider text-zinc-400">
