function HostsTab({
  caseId,
  evidenceId,
  analysis,
}: {
  caseId: string;
  evidenceId: string;
  analysis: PcapAnalysis | null;
}) {
  const [hosts, setHosts] =
    useState<NetworkHost[]>([]);

  const [loading, setLoading] =
    useState(true);

  const [discovering, setDiscovering] =
    useState(false);

  const [error, setError] =
    useState<string | null>(null);

  const [search, setSearch] =
    useState("");


  async function loadHosts() {
    try {
      setLoading(true);
      setError(null);

      const data =
        await getDiscoveredHosts(
          caseId,
          evidenceId
        );

      setHosts(data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to load hosts"
      );
    } finally {
      setLoading(false);
    }
  }


  async function handleDiscover() {
    try {
      setDiscovering(true);
      setError(null);

      const data =
        await discoverHosts(
          caseId,
          evidenceId
        );

      setHosts(data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to discover hosts"
      );
    } finally {
      setDiscovering(false);
    }
  }


  useEffect(() => {
    void loadHosts();
  }, [
    caseId,
    evidenceId,
  ]);


  const filteredHosts =
    useMemo(() => {
      const query =
        search
          .trim()
          .toLowerCase();

      if (!query) {
        return hosts;
      }

      return hosts.filter(
        (host) =>
          host.ip_address
            .toLowerCase()
            .includes(query)
      );
    }, [
      hosts,
      search,
    ]);


  const totalPackets =
    hosts.reduce(
      (sum, host) =>
        sum +
        host.packets_sent +
        host.packets_received,
      0
    );


  const totalBytes =
    hosts.reduce(
      (sum, host) =>
        sum +
        host.bytes_sent +
        host.bytes_received,
      0
    );


  const mostActive =
    hosts.length > 0
      ? [...hosts].sort(
          (a, b) =>
            b.packets_sent +
            b.packets_received -
            (a.packets_sent +
              a.packets_received)
        )[0]
      : null;


  if (!analysis) {
    return (
      <EmptyState
        title="Analyze the PCAP first"
        description="Host discovery is built from the network flows generated during PCAP analysis."
      />
    );
  }


  return (
    <div className="space-y-6">

      <div className="flex flex-col gap-4 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between dark:border-zinc-800 dark:bg-zinc-900">

        <div>
          <h2 className="text-base font-semibold text-zinc-950 dark:text-white">
            Host Discovery
          </h2>

          <p className="mt-1 text-sm text-zinc-500">
            Hosts derived from communication flows in the selected PCAP.
          </p>
        </div>

        <button
          type="button"
          onClick={handleDiscover}
          disabled={discovering}
          className="inline-flex items-center justify-center gap-2 rounded-xl bg-zinc-950 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-800 disabled:opacity-50 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
        >

          <Icon
            name="refresh"
            size={16}
          />

          {discovering
            ? "Discovering..."
            : hosts.length > 0
              ? "Refresh Hosts"
              : "Discover Hosts"}

        </button>

      </div>


      <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

        <StatCard
          label="Hosts"
          value={formatNumber(
            hosts.length
          )}
          description={`Analysis reported ${analysis.host_count}`}
          icon={
            <Icon
              name="server"
              size={17}
            />
          }
        />

        <StatCard
          label="Packets"
          value={formatNumber(
            totalPackets
          )}
          description="Sent + received"
        />

        <StatCard
          label="Traffic"
          value={formatBytes(
            totalBytes
          )}
          description="Sent + received"
        />

        <StatCard
          label="Most Active"
          value={
            mostActive
              ? mostActive.ip_address
              : "—"
          }
          description={
            mostActive
              ? `${formatNumber(
                  mostActive.packets_sent +
                    mostActive.packets_received
                )} packets`
              : "No data"
          }
        />

      </div>


      <div className="rounded-2xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">

        <div className="flex flex-col gap-4 border-b border-zinc-200 p-5 sm:flex-row sm:items-center sm:justify-between dark:border-zinc-800">

          <div>
            <h3 className="text-sm font-semibold text-zinc-950 dark:text-white">
              Discovered Hosts
            </h3>

            <p className="mt-1 text-xs text-zinc-500">
              {filteredHosts.length} hosts shown
            </p>
          </div>

          <div className="relative">

            <div className="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400">
              <Icon
                name="search"
                size={15}
              />
            </div>

            <input
              value={search}
              onChange={(event) =>
                setSearch(
                  event.target.value
                )
              }
              placeholder="Search IP..."
              className="w-full rounded-xl border border-zinc-200 bg-zinc-50 py-2 pl-9 pr-3 text-xs outline-none transition focus:border-zinc-400 sm:w-60 dark:border-zinc-700 dark:bg-zinc-950"
            />

          </div>

        </div>


        {loading ? (
          <div className="p-10 text-center text-sm text-zinc-500">
            Loading hosts...
          </div>
        ) : error ? (
          <div className="p-10 text-center text-sm text-red-600">
            {error}
          </div>
        ) : filteredHosts.length === 0 ? (
          <div className="p-10 text-center text-sm text-zinc-500">
            No hosts found.
          </div>
        ) : (
          <div className="overflow-x-auto">

            <table className="w-full min-w-[1000px] text-left">

              <thead className="bg-zinc-50 dark:bg-zinc-950">

                <tr className="border-b border-zinc-200 dark:border-zinc-800">

                  {[
                    "IP Address",
                    "Packets Sent",
                    "Packets Received",
                    "Bytes Sent",
                    "Bytes Received",
                    "Destinations",
                    "Sources",
                    "First Seen",
                    "Last Seen",
                  ].map(
                    (heading) => (
                      <th
                        key={heading}
                        className="px-5 py-3 text-[10px] font-semibold uppercase tracking-wider text-zinc-400"
                      >
                        {heading}
                      </th>
                    )
                  )}

                </tr>

              </thead>

              <tbody className="divide-y divide-zinc-100 dark:divide-zinc-800">

                {filteredHosts.map(
                  (host) => (
                    <tr
                      key={host.id}
                      className="transition hover:bg-zinc-50 dark:hover:bg-zinc-950"
                    >

                      <td className="px-5 py-4">
                        <span className="font-mono text-xs font-medium text-zinc-900 dark:text-white">
                          {host.ip_address}
                        </span>
                      </td>

                      <td className="px-5 py-4 text-xs tabular-nums">
                        {formatNumber(
                          host.packets_sent
                        )}
                      </td>

                      <td className="px-5 py-4 text-xs tabular-nums">
                        {formatNumber(
                          host.packets_received
                        )}
                      </td>

                      <td className="px-5 py-4 text-xs tabular-nums">
                        {formatBytes(
                          host.bytes_sent
                        )}
                      </td>

                      <td className="px-5 py-4 text-xs tabular-nums">
                        {formatBytes(
                          host.bytes_received
                        )}
                      </td>

                      <td className="px-5 py-4 text-xs tabular-nums">
                        {host.unique_destinations}
                      </td>

                      <td className="px-5 py-4 text-xs tabular-nums">
                        {host.unique_sources}
                      </td>

                      <td className="whitespace-nowrap px-5 py-4 text-[11px] text-zinc-500">
                        {formatTimestamp(
                          host.first_seen
                        )}
                      </td>

                      <td className="whitespace-nowrap px-5 py-4 text-[11px] text-zinc-500">
                        {formatTimestamp(
                          host.last_seen
                        )}
                      </td>

                    </tr>
                  )
                )}

              </tbody>

            </table>

          </div>
        )}

      </div>

    </div>
  );
}


