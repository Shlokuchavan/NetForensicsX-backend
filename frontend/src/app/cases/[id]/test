        </div>


        <div className="rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">

          <div className="flex items-center gap-3">

            <div className="flex h-9 w-9 items-center justify-center rounded-lg bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
              <Icon
                name="network"
                size={16}
              />
            </div>

            <div>
              <p className="text-xs font-semibold text-zinc-900 dark:text-white">
                Infrastructure
              </p>

              <p className="text-[11px] text-zinc-500">
                DNS / supporting services
              </p>
            </div>

          </div>

          <p className="mt-4 text-xs leading-5 text-zinc-500">
            Infrastructure nodes provide services such as DNS or
            other network-level communication.
          </p>

        </div>


        <div className="rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">

          <div className="flex items-center gap-3">

            <div className="flex h-9 w-9 items-center justify-center rounded-lg bg-zinc-950 text-white dark:bg-white dark:text-zinc-950">
              <Icon
                name="topology"
                size={16}
              />
            </div>

            <div>
              <p className="text-xs font-semibold text-zinc-900 dark:text-white">
                External Systems
              </p>

              <p className="text-[11px] text-zinc-500">
                Public / Internet hosts
              </p>
            </div>

          </div>

          <p className="mt-4 text-xs leading-5 text-zinc-500">
            Public IP addresses observed communicating with the
            internal environment.
          </p>

        </div>

      </div>


      {/* =================================================
          TOP CONNECTIONS
      ================================================= */}

      <div className="rounded-2xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">

        <div className="border-b border-zinc-200 p-6 dark:border-zinc-800">

          <div className="flex items-center justify-between">

            <div>
              <h3 className="text-sm font-semibold text-zinc-950 dark:text-white">
                Top Communication Paths
              </h3>

              <p className="mt-1 text-xs text-zinc-500">
                Highest-volume connections in the analyzed topology.
              </p>
            </div>

            {selectedNode && (
              <button
                type="button"
                onClick={() =>
                  setSelectedNode(
                    null
                  )
                }
                className="rounded-lg border border-zinc-200 px-3 py-2 text-[11px] font-medium text-zinc-600 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800"
              >
                Clear selection
              </button>
            )}

          </div>

        </div>


        <div className="overflow-x-auto">

          <table className="w-full min-w-[850px] text-left">

            <thead className="bg-zinc-50 dark:bg-zinc-950">

              <tr className="border-b border-zinc-200 dark:border-zinc-800">

                <th className="px-6 py-3 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
                  Source
                </th>

                <th className="px-6 py-3 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
                  Direction
                </th>

                <th className="px-6 py-3 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
                  Destination
                </th>

                <th className="px-6 py-3 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
                  Protocol
                </th>

                <th className="px-6 py-3 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
                  Packets
                </th>

                <th className="px-6 py-3 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
                  Traffic
                </th>

              </tr>

            </thead>


            <tbody className="divide-y divide-zinc-100 dark:divide-zinc-800">

              {visibleEdges
                .slice()
                .sort(
                  (a, b) =>
                    b.bytes -
                    a.bytes
                )
                .slice(0, 15)
                .map(
                  (edge) => {
                    const source =
                      topology.nodes.find(
                        (node) =>
                          node.id ===
                          edge.source
                      );

                    const target =
                      topology.nodes.find(
                        (node) =>
                          node.id ===
                          edge.target
                      );

                    const selected =
                      selectedNode ===
                        edge.source ||
                      selectedNode ===
                        edge.target;

                    return (
                      <tr
                        key={edge.id}
                        onClick={() => {
                          setSelectedNode(
                            edge.source
                          );
                        }}
                        className={`cursor-pointer transition hover:bg-zinc-50 dark:hover:bg-zinc-950 ${
                          selected
                            ? "bg-zinc-50 dark:bg-zinc-950"
                            : ""
                        }`}
                      >

                        <td className="px-6 py-4">

                          <div className="flex items-center gap-2">

                            <span
                              className={`h-2.5 w-2.5 rounded-full ${
                                source &&
                                classifyNode(
                                  source
                                ) ===
                                  "internal"
                                  ? "border border-zinc-950 bg-white dark:border-white dark:bg-zinc-950"
                                  : "bg-zinc-950 dark:bg-white"
                              }`}
                            />

                            <span className="font-mono text-xs text-zinc-900 dark:text-white">
                              {edge.source}
                            </span>

                          </div>

                        </td>


                        <td className="px-6 py-4">

                          <div className="flex items-center gap-2 text-zinc-400">

                            <span className="h-px w-8 bg-zinc-300 dark:bg-zinc-700" />

                            <span className="text-xs">
                              →
                            </span>

                          </div>

                        </td>


                        <td className="px-6 py-4">

                          <div className="flex items-center gap-2">

                            <span
                              className={`h-2.5 w-2.5 rounded-full ${
                                target &&
                                classifyNode(
                                  target
                                ) ===
                                  "external"
                                  ? "bg-zinc-950 dark:bg-white"
                                  : "border border-zinc-500 bg-zinc-200 dark:bg-zinc-700"
                              }`}
                            />

                            <span className="font-mono text-xs text-zinc-900 dark:text-white">
                              {edge.target}
                            </span>

                          </div>

                        </td>


                        <td className="px-6 py-4">

                          <span className="rounded-md bg-zinc-100 px-2 py-1 text-[10px] font-semibold text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                            {getProtocolLabel(
                              edge
                            )}
                            {getEdgePortLabel(
                              edge
                            )}
                          </span>

                        </td>


                        <td className="px-6 py-4 text-xs tabular-nums text-zinc-600 dark:text-zinc-300">
                          {formatNumber(
                            edge.packets
                          )}
                        </td>


                        <td className="px-6 py-4 text-xs font-medium tabular-nums text-zinc-900 dark:text-white">
                          {formatBytes(
                            edge.bytes
                          )}
                        </td>

                      </tr>
                    );
                  }
                )}

            </tbody>

          </table>

        </div>

      </div>


      {/* =================================================
          SELECTED CONNECTION SUMMARY
      ================================================= */}

      {selectedNode &&
        selectedEdges.length > 0 && (
          <div className="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">

            <div className="flex items-center justify-between">

              <div>

                <p className="text-[10px] font-semibold uppercase tracking-[0.12em] text-zinc-400">
                  Investigation Focus
                </p>

                <h3 className="mt-1 font-mono text-sm font-semibold text-zinc-950 dark:text-white">
                  {selectedNode}
                </h3>

              </div>

              <span className="rounded-full bg-zinc-100 px-3 py-1.5 text-[10px] font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                {selectedEdges.length} related connections
              </span>

            </div>

            <div className="mt-5 grid gap-3">

              {selectedEdges
                .slice(0, 8)
                .map(
                  (edge) => (
                    <div
                      key={edge.id}
                      className="flex flex-col gap-3 rounded-xl border border-zinc-200 p-4 sm:flex-row sm:items-center sm:justify-between dark:border-zinc-800"
                    >

                      <div className="flex items-center gap-3">

                        <span className="font-mono text-xs text-zinc-900 dark:text-white">
                          {edge.source}
                        </span>

                        <span className="text-zinc-400">
                          →
                        </span>

                        <span className="font-mono text-xs text-zinc-900 dark:text-white">
                          {edge.target}
                        </span>

                      </div>

                      <div className="flex items-center gap-3">

                        <span className="rounded-md bg-zinc-100 px-2 py-1 text-[10px] font-semibold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                          {getProtocolLabel(
                            edge
                          )}
                        </span>

                        <span className="text-xs text-zinc-500">
                          {formatNumber(
                            edge.packets
                          )}{" "}
                          packets
                        </span>

                        <span className="text-xs font-medium text-zinc-900 dark:text-white">
                          {formatBytes(
                            edge.bytes
                          )}
                        </span>

                      </div>

                    </div>
                  )
                )}

            </div>

          </div>
        )}

    </div>
  );
}


