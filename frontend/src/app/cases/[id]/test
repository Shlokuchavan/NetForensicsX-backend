/* =========================================================
   MAIN CASE PAGE
========================================================= */

export default function CasePage() {
  const params =
    useParams();

  const caseId =
    typeof params.id ===
    "string"
      ? params.id
      : Array.isArray(
          params.id
        )
        ? params.id[0]
        : "";


  const [caseData, setCaseData] =
    useState<Case | null>(null);

  const [evidence, setEvidence] =
    useState<Evidence[]>([]);

  const [selectedEvidenceId, setSelectedEvidenceId] =
    useState<string | null>(null);

  const [analysisMap, setAnalysisMap] =
    useState<
      Record<
        string,
        PcapAnalysis | null
      >
    >({});

  const [activeTab, setActiveTab] =
    useState<TabId>(
      "overview"
    );

  const [theme, setTheme] =
    useState<Theme>("light");

  const [loading, setLoading] =
    useState(true);

  const [error, setError] =
    useState<string | null>(null);

  const [uploading, setUploading] =
    useState(false);

  const [analyzingId, setAnalyzingId] =
    useState<string | null>(null);


  /* =====================================================
     THEME
  ===================================================== */

  useEffect(() => {
    const stored =
      window.localStorage.getItem(
        "netforensicx-theme"
      ) as Theme | null;

    const initialTheme =
      stored === "dark" ||
      stored === "light"
        ? stored
        : "light";

    setTheme(
      initialTheme
    );

    document.documentElement.classList.toggle(
      "dark",
      initialTheme === "dark"
    );
  }, []);


  function toggleTheme() {
    const nextTheme =
      theme === "light"
        ? "dark"
        : "light";

    setTheme(
      nextTheme
    );

    document.documentElement.classList.toggle(
      "dark",
      nextTheme === "dark"
    );

    window.localStorage.setItem(
      "netforensicx-theme",
      nextTheme
    );
  }


  /* =====================================================
     LOAD CASE
  ===================================================== */

  useEffect(() => {
    if (!caseId) {
      return;
    }

    async function loadCase() {
      try {
        setLoading(true);
        setError(null);

        const cases =
          await getCases();

        const currentCase =
          cases.find(
            (item) =>
              item.id ===
              caseId
          );

        if (!currentCase) {
          throw new Error(
            "Case not found"
          );
        }

        setCaseData(
          currentCase
        );

        const evidenceData =
          await getCaseEvidence(
            caseId
          );

        setEvidence(
          evidenceData
        );

        if (
          evidenceData.length >
          0
        ) {
          setSelectedEvidenceId(
            evidenceData[0].id
          );

          const analyses =
            await Promise.all(
              evidenceData.map(
                async (
                  item
                ) => {
                  try {
                    const result =
                      await getEvidenceAnalysis(
                        caseId,
                        item.id
                      );

                    return [
                      item.id,
                      result,
                    ] as const;
                  } catch {
                    return [
                      item.id,
                      null,
                    ] as const;
                  }
                }
              )
            );

          setAnalysisMap(
            Object.fromEntries(
              analyses
            )
          );
        }

      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : "Unable to load case"
        );
      } finally {
        setLoading(false);
      }
    }

    void loadCase();
  }, [
    caseId,
  ]);


  /* =====================================================
     ANALYZE
  ===================================================== */

  async function handleAnalyze(
    evidenceId: string
  ) {
    try {
      setAnalyzingId(
        evidenceId
      );

      setError(null);

      const result =
        await analyzeEvidence(
          caseId,
          evidenceId
        );

      setAnalysisMap(
        (current) => ({
          ...current,
          [evidenceId]:
            result,
        })
      );

      setSelectedEvidenceId(
        evidenceId
      );

    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to analyze evidence"
      );
    } finally {
      setAnalyzingId(
        null
      );
    }
  }


  /* =====================================================
     UPLOAD
  ===================================================== */

  async function handleUpload(
    event: React.ChangeEvent<HTMLInputElement>
  ) {
    const file =
      event.target.files?.[0];

    if (!file) {
      return;
    }

    try {
      setUploading(true);
      setError(null);

      const uploaded =
        await uploadEvidence(
          caseId,
          file
        );

      setEvidence(
        (current) => [
          uploaded,
          ...current,
        ]
      );

      setSelectedEvidenceId(
        uploaded.id
      );

      setAnalysisMap(
        (current) => ({
          ...current,
          [uploaded.id]:
            null,
        })
      );

    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to upload evidence"
      );
    } finally {
      setUploading(
        false
      );

      event.target.value =
        "";
    }
  }


  /* =====================================================
     SELECTED DATA
  ===================================================== */

  const selectedEvidence =
    evidence.find(
      (item) =>
        item.id ===
        selectedEvidenceId
    ) ?? null;


  const selectedAnalysis =
    selectedEvidence
      ? analysisMap[
          selectedEvidence.id
        ] ?? null
      : null;


  /* =====================================================
     LOADING
  ===================================================== */

  if (loading) {
    return (
      <main className="min-h-screen bg-zinc-50 p-6 dark:bg-zinc-950">

        <div className="mx-auto max-w-7xl">

          <div className="flex min-h-[60vh] items-center justify-center">

            <div className="text-center">

              <div className="mx-auto h-8 w-8 animate-spin rounded-full border-2 border-zinc-200 border-t-zinc-900 dark:border-zinc-800 dark:border-t-white" />

              <p className="mt-4 text-sm text-zinc-500">
                Loading investigation...
              </p>

            </div>

          </div>

        </div>

      </main>
    );
  }


  if (!caseData) {
    return (
      <main className="min-h-screen bg-zinc-50 p-6 dark:bg-zinc-950">

        <div className="mx-auto max-w-7xl">

          <div className="rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/20 dark:text-red-400">
            {error ??
              "Case not found"}
          </div>

        </div>

      </main>
    );
  }


  /* =====================================================
     RENDER TAB
  ===================================================== */

  function renderTab() {
    switch (activeTab) {

      case "overview":
        return (
          <OverviewTab
            evidence={
              evidence
            }
            analysisMap={
              analysisMap
            }
            selectedEvidence={
              selectedEvidence
            }
            onSelectEvidence={(
              id
            ) =>
              setSelectedEvidenceId(
                id
              )
            }
            onAnalyze={
              handleAnalyze
            }
          />
        );


      case "evidence":
        return (
          <EvidenceTab
            evidence={
              evidence
            }
            selectedEvidenceId={
              selectedEvidenceId
            }
            analysisMap={
              analysisMap
            }
            onSelect={(
              id
            ) =>
              setSelectedEvidenceId(
                id
              )
            }
            onAnalyze={
              handleAnalyze
            }
            onUpload={
              handleUpload
            }
            uploading={
              uploading
            }
            analyzingId={
              analyzingId
            }
          />
        );


      case "analysis":
        return (
          <AnalysisTab
            analysis={
              selectedAnalysis
            }
          />
        );


      case "hosts":
        return selectedEvidence ? (
          <HostsTab
            caseId={
              caseId
            }
            evidenceId={
              selectedEvidence.id
            }
            analysis={
              selectedAnalysis
            }
          />
        ) : (
          <EmptyState
            title="No evidence selected"
            description="Select a PCAP from the Evidence tab."
          />
        );


      case "flows":
        return selectedEvidence ? (
          <FlowsTab
            caseId={
              caseId
            }
            evidenceId={
              selectedEvidence.id
            }
            analysis={
              selectedAnalysis
            }
          />
        ) : (
          <EmptyState
            title="No evidence selected"
            description="Select a PCAP from the Evidence tab."
          />
        );


      case "topology":
        return selectedEvidence ? (
          <TopologyTab
            caseId={
              caseId
            }
            evidenceId={
              selectedEvidence.id
            }
            analysis={
              selectedAnalysis
            }
          />
        ) : (
          <EmptyState
            title="No evidence selected"
            description="Select a PCAP from the Evidence tab."
          />
        );


      default:
        return null;
    }
  }


  /* =====================================================
     MAIN UI
  ===================================================== */

  return (
    <main className="min-h-screen bg-zinc-50 text-zinc-950 transition-colors dark:bg-zinc-950 dark:text-white">

      {/* =================================================
          TOP BAR
      ================================================= */}

      <header className="sticky top-0 z-40 border-b border-zinc-200/80 bg-white/90 backdrop-blur-xl dark:border-zinc-800/80 dark:bg-zinc-950/90">

        <div className="mx-auto flex h-16 max-w-[1600px] items-center justify-between px-4 sm:px-6 lg:px-8">

          <div className="flex items-center gap-3">

            <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-zinc-950 text-white dark:bg-white dark:text-zinc-950">
              <Icon
                name="shield"
                size={16}
              />
            </div>

            <div>

              <p className="text-sm font-semibold tracking-tight">
                NetForensicX
              </p>

              <p className="hidden text-[10px] uppercase tracking-[0.15em] text-zinc-400 sm:block">
                Network Forensics
              </p>

            </div>

          </div>


          <ThemeToggle
            theme={theme}
            onToggle={
              toggleTheme
            }
          />

        </div>

      </header>


      {/* =================================================
          CASE HEADER
      ================================================= */}

      <section className="border-b border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-950">

        <div className="mx-auto max-w-[1600px] px-4 py-7 sm:px-6 lg:px-8">

          <button
            type="button"
            onClick={() =>
              window.history.back()
            }
            className="mb-5 flex items-center gap-2 text-xs font-medium text-zinc-500 transition hover:text-zinc-900 dark:hover:text-white"
          >

            <Icon
              name="arrow"
              size={14}
            />

            Back to Cases

          </button>


          <div className="flex flex-col gap-6 xl:flex-row xl:items-end xl:justify-between">

            <div>

              <div className="flex flex-wrap items-center gap-2">

                <span className="rounded-full border border-zinc-200 bg-zinc-50 px-2.5 py-1 font-mono text-[10px] font-medium text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
                  {caseData.case_number}
                </span>

                <span className="inline-flex items-center gap-1.5 rounded-full bg-zinc-100 px-2.5 py-1 text-[10px] font-medium capitalize text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">

                  <span className="h-1.5 w-1.5 rounded-full bg-zinc-500" />

                  {caseData.status}

                </span>

                <span className="rounded-full border border-zinc-200 px-2.5 py-1 text-[10px] font-medium capitalize text-zinc-500 dark:border-zinc-800">
                  Severity:{" "}
                  {caseData.severity}
                </span>

              </div>


              <h1 className="mt-4 text-2xl font-semibold tracking-tight text-zinc-950 sm:text-3xl dark:text-white">
                {caseData.name}
              </h1>

              {caseData.description && (
                <p className="mt-2 max-w-2xl text-sm leading-6 text-zinc-500">
                  {caseData.description}
                </p>
              )}

            </div>


            <div className="w-full xl:w-[360px]">

              <p className="mb-2 text-[10px] font-semibold uppercase tracking-[0.12em] text-zinc-400">
                Active Evidence
              </p>

              <div className="relative">

                <select
                  value={
                    selectedEvidenceId ??
                    ""
                  }
                  onChange={(
                    event
                  ) => {
                    setSelectedEvidenceId(
                      event.target.value
                    );
                  }}
                  className="w-full appearance-none rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-3 pr-10 text-xs font-medium text-zinc-800 outline-none transition focus:border-zinc-400 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200"
                >

                  {evidence.length ===
                  0 ? (
                    <option value="">
                      No evidence
                    </option>
                  ) : (
                    evidence.map(
                      (item) => (
                        <option
                          key={
                            item.id
                          }
                          value={
                            item.id
                          }
                        >
                          {
                            item.original_filename
                          }
                        </option>
                      )
                    )
                  )}

                </select>

                <div className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400">

                  <Icon
                    name="chevron"
                    size={15}
                  />

                </div>

              </div>

            </div>

          </div>

        </div>

      </section>


      {/* =================================================
          TABS
      ================================================= */}

      <CaseTabs
        activeTab={
          activeTab
        }
        onChange={
          setActiveTab
        }
      />


      {/* =================================================
          CONTENT
      ================================================= */}

      <section className="mx-auto max-w-[1600px] px-4 py-7 sm:px-6 lg:px-8">

        {error && (
          <div className="mb-6 flex items-start justify-between gap-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-xs text-red-700 dark:border-red-900 dark:bg-red-950/20 dark:text-red-400">

            <span>
              {error}
            </span>

            <button
              type="button"
              onClick={() =>
                setError(
                  null
                )
              }
              className="font-medium hover:underline"
            >
              Dismiss
            </button>

          </div>
        )}

        {renderTab()}

      </section>

    </main>
  );
}