                  type="button"
                  disabled={
                    flows.length <
                      pageSize ||
                    loading
                  }
                  onClick={() =>
                    setPage(
                      (value) =>
                        value + 1
                    )
                  }
                  className="rounded-lg border border-zinc-200 px-3 py-2 text-xs font-medium disabled:opacity-40 dark:border-zinc-700"
                >
                  Next
                </button>

              </div>

            </div>

          </>
        )}

      </div>

    </div>
  );
}


/* =========================================================
   TOPOLOGY HELPERS
========================================================= */

function buildTopologyPositions(
  nodes: NetworkTopology["nodes"],
  width: number,
  height: number
): Map<string, TopologyPosition> {
  const positions =
    new Map<
      string,
      TopologyPosition
    >();

  const internal =
    nodes.filter(
      (node) =>
        classifyNode(node) ===
        "internal"
    );

  const infrastructure =
    nodes.filter(
      (node) =>
        classifyNode(node) ===
        "infrastructure"
    );

  const external =
    nodes.filter(
      (node) =>
        classifyNode(node) ===
        "external"
    );


  function distribute(
    list: NetworkTopology["nodes"],
    x: number
  ) {
    if (list.length === 0) {
      return;
    }

    const top =
      150;

    const bottom =
      height - 90;

    const usableHeight =
      bottom - top;

    list.forEach(
      (node, index) => {
        const y =
          list.length === 1
            ? height / 2
            : top +
              (usableHeight *
                index) /
                (list.length - 1);

        positions.set(
          node.id,
          {
            x,
            y,
          }
        );
      }
    );
  }


  distribute(
    internal,
    170
  );

  distribute(
    infrastructure,
    width / 2
  );

  distribute(
    external,
    width - 170
  );


  return positions;
}


function getCurvePath(
  source: TopologyPosition,
  target: TopologyPosition
): string {
  const distance =
    Math.abs(
      target.x -
        source.x
    );

  const controlOffset =
    Math.max(
      80,
      distance * 0.38
    );

  const direction =
    target.x >= source.x
      ? 1
      : -1;

  const c1x =
    source.x +
    controlOffset *
      direction;

  const c2x =
    target.x -
    controlOffset *
      direction;

  return [
    `M ${source.x} ${source.y}`,
    `C ${c1x} ${source.y}`,
    `${c2x} ${target.y}`,
    `${target.x} ${target.y}`,
  ].join(" ");
}


